---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../data/site.json';
// Поля формы предварительные: состав уточняется у владельца магазина.
---
<Base title="Оформление заказа" noindex>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Корзина', href: '/cart/' }, { label: 'Оформление' }]} />
    <div class="page-title"><h1>Оформление заказа</h1></div>
    <form class="cart section" style="padding-top: 0;" id="order-form" data-dadata={site.dadataToken} novalidate>
      <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="stack" style="gap: 16px;">
        <fieldset class="card stack">
          <legend><h4>Контактные данные</h4></legend>
          <div class="two">
            <label class="field">Имя и фамилия<input name="name" autocomplete="name" required /></label>
            <label class="field">Телефон<input name="phone" type="tel" autocomplete="tel" required /></label>
          </div>
          <label class="field">Электронная почта<input name="email" type="email" autocomplete="email" required /><small data-email-hint>Пришлём на неё счёт и номер отправления</small></label>
        </fieldset>
        <fieldset class="card stack">
          <legend><h4>Покупатель</h4></legend>
          <div class="chips seg">
            <label class="chip"><input type="radio" name="buyer" value="Физическое лицо" checked />Физическое лицо</label>
            <label class="chip"><input type="radio" name="buyer" value="Организация или ИП" />Организация или ИП</label>
          </div>
          <div class="two" data-org hidden>
            <label class="field">Название организации<input name="company" autocomplete="organization" /></label>
            <label class="field">ИНН<input name="inn" inputmode="numeric" maxlength="12" /></label>
          </div>
          <div class="stack" data-org hidden style="gap: 8px;">
            <span class="small muted">Счёт</span>
            <div class="chips seg">
              <label class="chip"><input type="radio" name="vat" value="С НДС" checked />С НДС</label>
              <label class="chip"><input type="radio" name="vat" value="Без НДС" />Без НДС</label>
            </div>
          </div>
        </fieldset>
        <fieldset class="card stack">
          <legend><h4>Доставка</h4></legend>
          <label class="opt"><input type="radio" name="delivery" value="Транспортная компания" checked /><span><b>Транспортная компания</b><small>Отправим в ваш город, передадим номер отправления</small></span><em>По тарифу ТК</em></label>
          <label class="opt"><input type="radio" name="delivery" value="Самовывоз" /><span><b>Самовывоз</b><small>{site.city}, {site.address}, {site.hours}</small></span><em>Бесплатно</em></label>
          <div class="two" data-address>
            <label class="field">Город<input name="city" placeholder="Начните вводить название" /></label>
            <label class="field">Адрес или пункт выдачи<input name="address" placeholder="Улица и дом" /></label>
          </div>
        </fieldset>
        <fieldset class="card stack">
          <legend><h4>Оплата</h4></legend>
          <p class="muted small pay-note">Оплата не на сайте. Проверим наличие, посчитаем доставку и пришлём счёт на точную сумму. Заказ отправляем после оплаты.</p>
          <label class="opt" data-pay="invoice"><input type="radio" name="payment" value="По счёту" checked /><span><b>По счёту</b><small>Пришлём счёт на почту. Оплатить можно с расчётного счёта организации или в приложении любого банка. Организациям передадим закрывающие документы</small></span></label>
          <label class="opt" data-pay="pickup"><input type="radio" name="payment" value="При получении" /><span><b>При получении в офисе</b><small data-pickup-hint>Наличными или картой. Доступно только при самовывозе</small></span></label>
        </fieldset>
        <fieldset class="card stack">
          <legend><h4>Комментарий к заказу</h4></legend>
          <label class="field">Необязательно<textarea name="comment" placeholder="Марка техники, удобное время для звонка"></textarea></label>
        </fieldset>
      </div>
      <aside class="card stack">
        <h4>Ваш заказ</h4>
        <ul class="lines" id="order-lines"></ul>
        <div class="total"><span id="total-label">Итого без доставки</span><b id="order-total"></b></div>
        <label class="check"><input type="checkbox" name="consent" required />Согласен на <a href="/consent/">обработку персональных данных</a></label>
        <button class="btn btn--l btn--block" type="submit">Оформить заказ</button>
        <p class="error" id="order-error" role="alert" hidden></p>
        <p class="muted small" style="margin: 0;">Это ещё не оплата. Проверим наличие и свяжемся с вами в рабочее время, {site.hours}.</p>
      </aside>
    </form>
  </div>
</Base>

<script>
  import { readCart, writeCart, cartTotal, money } from '../scripts/cart';
  import { setupAddress } from '../scripts/suggest';
  import { sendForm, orderNumber, isBot } from '../scripts/send';

  const form = document.getElementById('order-form') as HTMLFormElement;
  const error = document.getElementById('order-error')!;
  const items = readCart();
  if (!items.length) location.replace(`${import.meta.env.BASE_URL}cart/`);
  setupAddress(form, form.dataset.dadata || '');
  // поля организации и адреса показываем только когда они нужны
  const radio = (name: string) => form.elements.namedItem(name) as RadioNodeList;
  const payInput = (key: string) => form.querySelector<HTMLInputElement>(`[data-pay="${key}"] input`)!;
  const sync = () => {
    const org = radio('buyer').value !== 'Физическое лицо';
    form.querySelectorAll<HTMLElement>('[data-org]').forEach((el) => (el.hidden = !org));
    const pickup = radio('delivery').value === 'Самовывоз';
    form.querySelector<HTMLElement>('[data-address]')!.hidden = pickup;
    // оплата при получении возможна только в офисе
    const cash = payInput('pickup');
    cash.disabled = !pickup;
    cash.closest('.opt')!.classList.toggle('opt--disabled', !pickup);
    if (!pickup && cash.checked) payInput('invoice').checked = true;
    // почта нужна для счёта; при оплате в офисе можно без неё
    const email = form.elements.namedItem('email') as HTMLInputElement;
    email.required = !cash.checked;
    form.querySelector('[data-email-hint]')!.textContent = cash.checked ? 'Необязательно. Без почты позвоним, когда заказ будет готов' : 'Пришлём на неё счёт и номер отправления';
    document.getElementById('total-label')!.textContent = pickup ? 'Итого' : 'Итого без доставки';
  };
  form.addEventListener('change', sync);
  sync();

  const lines = document.getElementById('order-lines')!;
  for (const i of items) {
    const li = document.createElement('li');
    const sku = Object.assign(document.createElement('span'), { className: 'mono', textContent: i.sku });
    const name = Object.assign(document.createElement('span'), { className: 'muted', textContent: i.title });
    const qty = Object.assign(document.createElement('b'), { textContent: `${i.qty} × ${money(i.price)}` });
    li.append(sku, name, qty);
    lines.append(li);
  }
  document.getElementById('order-total')!.textContent = money(cartTotal(items));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.hidden = true;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (isBot(form)) return;
    const fd = new FormData(form);
    const v = (k: string) => String(fd.get(k) ?? '').trim();
    const pickup = v('delivery') === 'Самовывоз';
    const number = orderNumber();
    const total = cartTotal(items);
    const lines = items.map((i, n) => `${n + 1}. ${i.sku} ${i.title}: ${i.qty} шт. × ${money(i.price)} = ${money(i.price * i.qty)}`).join('\n');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    const res = await sendForm(
      `Заказ ${number} на ${money(total)}`,
      {
        'Номер заказа': number,
        'Состав заказа': lines,
        'Итого': money(total),
        'Имя': v('name'),
        'Телефон': v('phone'),
        'Почта': v('email'),
        'Покупатель': v('buyer'),
        'Организация': v('company'),
        'ИНН': v('inn'),
        'НДС': v('buyer') === 'Физическое лицо' ? '' : v('vat'),
        'Доставка': v('delivery'),
        'Город': pickup ? '' : v('city'),
        'Адрес или пункт выдачи': pickup ? '' : v('address'),
        'Оплата': v('payment'),
        'Комментарий': v('comment'),
      },
      v('email') || undefined,
    );
    btn.disabled = false;
    if (!res.ok) {
      error.textContent = res.error!;
      error.hidden = false;
      return;
    }
    sessionStorage.setItem('ee-last-order', JSON.stringify({ number, total, payment: v('payment'), pickup, email: v('email'), items: items.map((i) => ({ sku: i.sku, title: i.title, qty: i.qty })) }));
    writeCart([]);
    location.href = `${import.meta.env.BASE_URL}order-done/`;
  });
</script>

<style is:global>
  fieldset.card { border: 0; margin: 0; min-width: 0; }
  fieldset.card legend { float: left; width: 100%; padding: 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; clear: both; }
  .opt { display: flex; gap: 12px; padding: 16px 20px 16px 16px; border: 1px solid var(--border-default); border-radius: var(--radius-md); cursor: pointer; clear: both; }
  .opt:has(input:checked) { border-color: var(--border-strong); box-shadow: inset 0 0 0 0.5px var(--border-strong); }
  .opt--disabled { opacity: 0.5; cursor: not-allowed; }
  .opt--disabled input { cursor: not-allowed; }
  .pay-note { margin: 0; clear: both; }
  .opt em { margin-left: auto; font: 500 14px/20px var(--font); white-space: nowrap; }
  .opt span { flex: 1; }
  .seg .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .seg .chip:has(input:checked) { background: var(--bg-inverse); color: var(--text-inverse); box-shadow: none; }
  .seg .chip:has(input:focus-visible) { outline: 2px solid var(--border-strong); outline-offset: 2px; }
  .opt input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--bg-inverse); }
  .opt span { display: grid; gap: 2px; }
  .opt small { font-size: 14px; line-height: 20px; color: var(--text-secondary); }
  .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 14px; line-height: 20px; }
  .lines li { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; }
  .error { color: var(--text-danger); font-size: 14px; margin: 0; }
  @media (max-width: 600px) { .two { grid-template-columns: 1fr; } }
</style>
