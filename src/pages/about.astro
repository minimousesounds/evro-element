---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import about from '../data/about.json';
import { getCategories } from '../lib/catalog';
const categories = await getCategories();
const years = new Date().getFullYear() - site.foundingYear;
const phoneHref = 'tel:' + site.phone.replace(/[^\d+]/g, '');
// Тексты страницы правятся в админке (Настройки → Страница «О компании»). Подстановки считаются при сборке.
const yearsWord = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'год' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'года' : 'лет');
const fill = (t: string) =>
  t.replaceAll('{компания}', site.legalName).replaceAll('{год}', String(site.foundingYear))
    .replaceAll('{лет}', `${years} ${yearsWord(years)}`).replaceAll('{категорий}', String(categories.length));
---
<Base title="О компании" description={fill(about.seoDescription)}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'О компании' }]} />
    <div class="page-title"><h1>О компании</h1></div>

    <div class="intro">
      <div class="intro__text">
        <p class="t-h3">{fill(about.intro)}</p>
        {about.paragraphs.map((p) => <p class="lead">{fill(p)}</p>)}
      </div>
      <div class="intro__stats">
        {about.stats.map((st) => { const v = fill(st.value); return <div class="stat"><b class:list={{ stat__s: v.length > 8 }}>{v}</b><span>{fill(st.text)}</span></div>; })}
      </div>
    </div>

    <section class="section stack">
      <h2>{about.featuresTitle}</h2>
      <div class="features">
        {about.features.map((f) => <div class="feature"><span class="feature__icon"><Icon name={f.icon as any} /></span><h3 class="t-h4">{f.title}</h3><p>{fill(f.text)}</p></div>)}
      </div>
    </section>

    <section class="section">
      <div class="cta">
        <div><h2>{about.ctaTitle}</h2><p>{site.city}, {site.address}. {site.hours}</p></div>
        <div class="row">
          <a class="btn btn--l" href={phoneHref}><Icon name="phone" size={20} />{site.phone}</a>
          <a class="btn btn--l btn--outline" href="/contacts/">Контакты</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .intro { display: flex; gap: 48px; align-items: flex-start; }
  .intro__text { flex: 1; display: grid; gap: 20px; }
  .intro__text p { margin: 0; }
  .intro__stats { width: 560px; flex: none; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .stat { display: flex; flex-direction: column; justify-content: space-between; gap: 8px; min-height: 150px; padding: 24px; border-radius: 16px; background: var(--bg-inverse); }
  .stat b { font: 600 36px/42px var(--font); letter-spacing: -0.02em; color: var(--text-accent); }
  .stat b.stat__s { font-size: 24px; line-height: 30px; }
  .stat span { font-size: 14px; line-height: 20px; color: var(--text-inverse-secondary); }
  .features { display: grid; gap: var(--gap); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .feature { display: flex; flex-direction: column; gap: 16px; padding: 28px; border-radius: 16px; background: var(--bg-surface); }
  .feature p { margin: 0; font-size: 14px; line-height: 20px; color: var(--text-secondary); }
  .feature__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--bg-accent); }
  .cta { display: flex; gap: 24px; align-items: center; justify-content: space-between; padding: 48px; border-radius: var(--radius-lg); background: var(--bg-inverse); color: var(--text-inverse); }
  .cta p { margin: 8px 0 0; color: var(--text-inverse-secondary); }
  @media (max-width: 1100px) {
    .intro { flex-direction: column; gap: 24px; }
    .intro__stats { width: 100%; }
    .stat b { font-size: 26px; line-height: 32px; }
    .stat b.stat__s { font-size: 20px; line-height: 26px; }
    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feature { padding: 20px; }
    .cta { flex-direction: column; align-items: flex-start; padding: 32px; }
  }
  @media (max-width: 600px) {
    .intro__stats { gap: 12px; }
    .stat { min-height: 0; padding: 16px; }
    .stat b.stat__s { font-size: 18px; line-height: 24px; }
    .features { grid-template-columns: 1fr; }
    .cta { padding: 24px; }
    .cta .row, .cta .btn { width: 100%; }
  }
</style>
