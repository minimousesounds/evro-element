---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
const phoneHref = 'tel:' + site.phone.replace(/[^\d+]/g, '');
const mapQuery = encodeURIComponent(`${site.city}, ${site.addressShort}`);
---
<Base title="Контакты" description={`${site.name}: ${site.city}, ${site.address}. Телефон ${site.phone}, ${site.hours}.`}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Контакты' }]} />
    <div class="page-title"><h1>Контакты</h1></div>

    <div class="contacts">
      <address class="info">
        <div class="info__phone">
          <span class="tertiary small">Телефон</span>
          <a class="t-h3" href={phoneHref}>{site.phone}</a>
          <button class="btn" type="button" data-callback>Заказать звонок</button>
        </div>
        <div class="info__row"><Icon name="mail" size={22} /><span><span class="tertiary small">Почта</span><a href={`mailto:${site.email}`}>{site.email}</a></span></div>
        <div class="info__row"><Icon name="pin" size={22} /><span><span class="tertiary small">Адрес</span><span>г. {site.city}, {site.address}</span></span></div>
        <div class="info__row"><Icon name="clock" size={22} /><span><span class="tertiary small">Режим работы</span><span>{site.hours}, Сб–Вс выходной</span></span></div>
      </address>
      <div class="map">
        <iframe src={`https://yandex.ru/map-widget/v1/?text=${mapQuery}&z=16`} title="Евроэлемент на карте" loading="lazy" allowfullscreen></iframe>
        <a class="map__link" href={`https://yandex.ru/maps/?text=${mapQuery}`} target="_blank" rel="noopener">Открыть в Яндекс Картах</a>
      </div>
    </div>

    <section class="section">
      <form class="write" data-lead data-subject="Сообщение со страницы «Контакты»" novalidate>
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="write__text">
          <h2>Напишите нам</h2>
          <p class="lead">Ответим на вопрос о наличии, подберём фильтр или выставим счёт. Перезваниваем в рабочее время.</p>
        </div>
        <div class="write__form">
          <div class="two">
            <label class="field">Имя<input name="name" autocomplete="name" placeholder="Как к вам обращаться" required /></label>
            <label class="field">Телефон<input name="phone" type="tel" autocomplete="tel" required /></label>
          </div>
          <label class="field">Сообщение<textarea name="comment" placeholder="Артикул, марка техники или вопрос"></textarea></label>
          <label class="check"><input type="checkbox" name="consent" required />Согласен на обработку персональных данных</label>
          <div><button class="btn btn--l btn--dark" type="submit">Отправить</button></div>
          <p class="lead__msg small" role="status" hidden></p>
        </div>
      </form>
    </section>
  </div>
</Base>

<script>
  // отправка формы та же, что у блока подбора
  import '../scripts/lead';
</script>

<style>
  .contacts { display: flex; gap: var(--gap); align-items: stretch; }
  .info { width: 480px; flex: none; font-style: normal; border-radius: var(--radius-lg); background: var(--bg-surface); }
  .info__phone { display: grid; gap: 12px; justify-items: start; padding: 28px; border-bottom: 1px solid var(--border-default); }
  .info__phone a { text-decoration: none; }
  .info__row { display: flex; gap: 16px; padding: 20px 28px; }
  .info__row + .info__row { border-top: 1px solid var(--border-default); }
  .info__row > span { display: grid; gap: 4px; font-weight: 500; }
  .info__row a { text-decoration: none; }
  .info__row .icon { flex: none; }
  .map { position: relative; flex: 1; min-height: 400px; border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-subtle); }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map__link { position: absolute; left: 16px; bottom: 16px; padding: 6px 10px; border-radius: var(--radius-sm); background: var(--bg-surface); font: 500 12px/16px var(--font); text-decoration: none; }
  .write { display: flex; gap: 48px; padding: 48px; border-radius: var(--radius-lg); background: var(--bg-surface); }
  .write__text { flex: 1; display: grid; gap: 12px; align-content: start; }
  .write__form { width: 560px; flex: none; display: grid; gap: 16px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lead__msg { margin: 0; font-weight: 500; }
  @media (max-width: 1100px) {
    .contacts { flex-direction: column; }
    .info { width: auto; }
    .map { min-height: 360px; }
    .write { flex-direction: column; gap: 24px; padding: 32px; }
    .write__form { width: auto; }
  }
  @media (max-width: 600px) {
    .info__phone { padding: 20px; }
    .info__row { padding: 16px 20px; }
    .map { min-height: 280px; }
    .write { padding: 20px; }
    .two { grid-template-columns: 1fr; }
    .write .btn { width: 100%; }
  }
</style>
