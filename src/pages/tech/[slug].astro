---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts, type Product } from '../../lib/catalog';

type Tech = CollectionEntry<'tech'>;

export async function getStaticPaths() {
  // Astro выносит getStaticPaths отдельно, поэтому помощник объявлен внутри
  const norm = (s: string) => s.toLowerCase().replace(/[\s\-_.]+/g, '');
  const all = await getCollection('tech');
  const products = await getProducts();
  return all.map((entry) => {
    // подходящие товары: выбранные в админке плюс те, чей артикул встречается в тексте страницы
    const text = norm((entry.body ?? '').replace(/<[^>]+>/g, ' '));
    const picked = new Set(entry.data.products.map((p) => p.id));
    const matched = products.filter((p) => picked.has(p.id) || (norm(p.data.sku).length >= 4 && text.includes(norm(p.data.sku))));
    return {
      params: { slug: entry.id },
      props: { entry, matched, parent: all.find((t) => t.id === entry.data.parent), children: all.filter((t) => t.data.parent === entry.id) },
    };
  });
}
interface Props { entry: Tech; parent?: Tech; children: Tech[]; matched: Product[] }
const { entry, parent, children, matched } = Astro.props;
const { Content } = await render(entry);
const crumbs = [
  { label: 'Главная', href: '/' },
  { label: 'Техническая информация', href: '/tech/' },
  ...(parent ? [{ label: parent.data.title, href: `/tech/${parent.id}/` }] : []),
  { label: entry.data.title },
];
---
<Base title={entry.data.title} description={entry.data.seoDescription || `${entry.data.title}: справочная информация и технические характеристики.`}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class="page-title"><h1>{entry.data.title}</h1></div>
    <article class="prose prose--wide">
      <Content />
      {children.length > 0 && (
        <ul>{children.map((c) => (<li><a href={`/tech/${c.id}/`}>{c.data.title}</a></li>))}</ul>
      )}
    </article>

    <section class="section stack">
      <h2>Подходящие товары</h2>
      {matched.length > 0 ? (
        <div class="grid">{matched.map((p) => <ProductCard product={p} />)}</div>
      ) : (
        <div class="card stack empty">
          <p class="lead">Подходящие товары не найдены. Позвоните или напишите нам, подберём фильтр по марке и модели техники.</p>
          <div class="row"><a class="btn btn--dark" href="/contacts/">Контакты</a><a class="btn btn--outline" href="/catalog/">Весь каталог</a></div>
        </div>
      )}
    </section>
  </div>
</Base>

<style>
  .empty .lead { margin: 0; }
</style>
