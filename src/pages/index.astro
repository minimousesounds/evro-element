---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { getCategories, getProducts, productUrl, formatPrice, brandLabel } from '../lib/catalog';

const categories = await getCategories();
const products = await getProducts();
const countBy = (id: string) => products.filter((p) => p.data.category.id === id).length;
const imageOf = (id: string) => categories.find((c) => c.id === id)?.data.image || products.find((p) => p.data.category.id === id && p.data.images.length)?.data.images[0];
// первые четыре категории с картинкой крупно, остальные списком
const withImage = categories.filter((c) => imageOf(c.id)).slice(0, 4);
const rest = categories.filter((c) => !withImage.includes(c));
// пока в админке никто не отметил «на главной», показываем товары с фото
const popular = products.filter((p) => p.data.popular);
const offers = products.filter((p) => p.data.offer);
const featured = (popular.length ? popular : products.filter((p) => p.data.images.length)).slice(0, 8);
const hero = products.find((p) => p.data.images.length && p.data.popular) ?? products.find((p) => p.data.images.length);
const tags = products.filter((p) => p.data.images.length).slice(0, 5).map((p) => p.data.sku);
const years = new Date().getFullYear() - site.foundingYear;
---
<Base
  rawTitle
  title={`Автомобильные фильтры в Набережных Челнах | ${site.name}`}
  description={`Масляные, топливные, воздушные и гидравлические фильтры для грузовой и легковой техники. Поиск по артикулу, самовывоз в Набережных Челнах и отправка транспортной компанией. ${site.phone}.`}
>
  <section class="container hero">
    <div class="hero__text">
      <span class="eyebrow">Аналоги фильтров ASAS в наличии</span>
      <h1 class="t-display">Автомобильные фильтры в Набережных Челнах</h1>
      <p class="lead">Аналоги масляных, топливных, воздушных и гидравлических фильтров ASAS. Ищите по привычному артикулу: покажем фильтр, который встаёт на то же место.</p>
      <form class="search search--l" action="/search/" method="get" role="search">
        <Icon name="search" size={24} class="search__icon" />
        <input type="search" name="q" placeholder="Артикул, например SP926M" aria-label="Поиск по каталогу" />
        <button class="btn" type="submit">Найти</button>
      </form>
      {tags.length > 0 && (
        <div class="hero__tags"><span class="tertiary small">Часто ищут:</span>{tags.map((t) => <a class="tag" href={`/search/?q=${encodeURIComponent(t)}`}>{t}</a>)}</div>
      )}
    </div>
    {hero && (
      <div class="hero__visual" aria-hidden="true">
        <span class="hero__circle"></span>
        <img class="hero__img" src={hero.data.images[0]} alt="" width="460" height="460" />
        <div class="hero__stat"><b>{years} лет</b><span>подбираем фильтры</span></div>
        <a class="hero__product" href={productUrl(hero)} tabindex="-1">
          <span class="hero__product-text">
            <span class="hero__product-meta"><span class="mono">{hero.data.sku}</span> {brandLabel(hero)}</span>
            <span class="hero__product-name">{hero.data.title}</span>
            <span class="hero__product-price">{formatPrice(hero.data.price)}</span>
          </span>
          <span class="btn"><Icon name="plus" size={20} />В корзину</span>
        </a>
      </div>
    )}
  </section>

  <section class="container section stack">
    <div class="sec-head"><h2>Каталог</h2><a class="text-link" href="/catalog/">Все категории<Icon name="arrow-right" size={20} /></a></div>
    <div class="cats-img">{withImage.map((c) => <CategoryCard category={c} count={countBy(c.id)} image={imageOf(c.id)} />)}</div>
    <div class="cats-text">{rest.map((c) => <CategoryCard category={c} count={countBy(c.id)} />)}</div>
  </section>

  <section class="container section stack" data-tabs>
    <div class="sec-head"><h2>Популярные товары</h2><a class="text-link" href="/catalog/">Весь каталог<Icon name="arrow-right" size={20} /></a></div>
    {offers.length > 0 && (
      <div class="chips" role="group" aria-label="Подборка">
        <button class="chip" type="button" aria-pressed="true" data-tab="popular">Популярные</button>
        <button class="chip" type="button" aria-pressed="false" data-tab="offer">Спецпредложения</button>
      </div>
    )}
    <div class="grid" data-panel="popular">{featured.map((p) => <ProductCard product={p} />)}</div>
    {offers.length > 0 && <div class="grid" data-panel="offer" hidden>{offers.slice(0, 8).map((p) => <ProductCard product={p} />)}</div>}
  </section>

  <section class="container section stack">
    <div class="intro">
      <h2>Честно об аналогах</h2>
      <p class="lead">Раньше мы поставляли оригинальные фильтры ASAS-FILTER. Сейчас привозим аналоги и говорим об этом прямо, чтобы вы точно знали, что покупаете.</p>
    </div>
    <div class="features">
      <div class="feature"><span class="feature__icon"><Icon name="search" /></span><h3 class="t-h4">Тот же артикул в поиске</h3><p>Ищите по номеру ASAS, к которому привыкли. Покажем аналог для этой позиции.</p></div>
      <div class="feature"><span class="feature__icon"><Icon name="check" /></span><h3 class="t-h4">Встаёт на место оригинала</h3><p>Совпадают посадочные размеры, резьба и уплотнение. Переделывать ничего не нужно.</p></div>
      <div class="feature"><span class="feature__icon"><Icon name="shield" /></span><h3 class="t-h4">Говорим как есть</h3><p>В каждой карточке указано, что это аналог и какой фильтр он заменяет.</p></div>
    </div>
  </section>

  <section class="container section stack" id="how">
    <h2>Как заказать</h2>
    <div class="how">
      <ol class="steps">
        <li><span class="steps__num">01</span><div><h3>Найдите фильтр</h3><p>По артикулу, названию или в каталоге по типу фильтра.</p></div></li>
        <li><span class="steps__num">02</span><div><h3>Оформите заказ</h3><p>Добавьте фильтры в корзину, укажите контакты и способ доставки.</p></div></li>
        <li><span class="steps__num">03</span><div><h3>Получите заказ</h3><p>Соберём заказ и отправим транспортной компанией или подготовим к самовывозу.</p></div></li>
      </ol>
      <div class="hook">
        <div><h3>Есть список артикулов?</h3><p>Пришлите его на почту, соберём заказ сами и свяжемся с вами.</p></div>
        <a class="btn" href={`mailto:${site.email}`}><Icon name="mail" size={20} />{site.email}</a>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="about">
      <div class="about__text">
        <span class="about__eyebrow">О компании</span>
        <h2>С {site.foundingYear} года знаем фильтры ASAS по артикулам</h2>
        <p class="lead">Много лет мы поставляли оригинальные фильтры ASAS-FILTER. Сейчас привозим аналоги и подбираем их по размерам, резьбе и кросс-номерам, чтобы фильтр встал на место оригинала.</p>
        <a class="btn" href="/about/">Подробнее о компании<Icon name="arrow-right" size={20} /></a>
      </div>
      <div class="about__stats">
        <div class="stat"><b>{years} лет</b><span>работаем с фильтрами в Набережных Челнах</span></div>
        <div class="stat"><b>{categories.length}</b><span>категорий фильтров и запчастей</span></div>
        <div class="stat"><b>1 : 1</b><span>посадочные размеры как у оригинала</span></div>
        <div class="stat"><b class="stat__s">По артикулу</b><span>ищите по номеру ASAS, подберём аналог</span></div>
      </div>
    </div>
  </section>

  <LeadForm />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    box.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((btn) =>
      btn.addEventListener('click', () => {
        box.querySelectorAll('[data-tab]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        box.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== btn.dataset.tab));
      }),
    );
  });
</script>

<style>
  .hero { display: flex; gap: 64px; align-items: center; padding-top: 64px; }
  .hero__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .hero__text .search { max-width: 640px; }
  .hero__tags { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .hero__visual { position: relative; width: 540px; height: 560px; flex: none; border-radius: var(--radius-lg); background: var(--bg-surface); overflow: hidden; }
  .hero__circle { position: absolute; width: 420px; height: 420px; left: 80px; top: 40px; border-radius: 50%; background: var(--bg-accent); }
  .hero__circle::after { content: ""; position: absolute; inset: 32px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgb(22 22 22 / 0.12); }
  .hero__img { position: absolute; width: 460px; height: 460px; left: 60px; top: 20px; object-fit: contain; mix-blend-mode: multiply; }
  .hero__stat { position: absolute; top: 24px; right: 24px; display: grid; gap: 2px; padding: 14px 18px; border-radius: var(--radius-md); background: var(--bg-inverse); }
  .hero__stat b { font: 600 24px/30px var(--font); color: var(--text-accent); }
  .hero__stat span { font: 500 12px/16px var(--font); color: var(--text-inverse-secondary); }
  .hero__product { position: absolute; left: 24px; bottom: 24px; display: flex; gap: 16px; align-items: center; padding: 16px 16px 16px 20px; border-radius: var(--radius-md);
    background: var(--bg-surface); box-shadow: inset 0 0 0 1px var(--border-default), 0 16px 40px -12px rgb(22 22 22 / 0.12); text-decoration: none; }
  .hero__product-text { display: grid; gap: 4px; }
  .hero__product-meta { font: 500 12px/16px var(--font); color: var(--text-tertiary); }
  .hero__product-meta .mono { color: var(--text-primary); }
  .hero__product-name { font-weight: 500; }
  .hero__product-price { font: 600 20px/24px var(--font); }

  .cats-img { display: grid; gap: var(--gap); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cats-text { display: grid; gap: var(--gap); grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .intro { display: grid; gap: 12px; }
  .features { display: grid; gap: var(--gap); grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .feature { display: flex; flex-direction: column; gap: 16px; padding: 28px; border-radius: var(--radius-lg); background: var(--bg-surface); }
  .feature p { margin: 0; font-size: 14px; line-height: 20px; color: var(--text-secondary); }
  .feature__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--bg-accent); }

  .how { display: flex; gap: var(--gap); }
  .steps { flex: 1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .steps li { display: flex; flex-direction: column; gap: 20px; padding: 28px; border-radius: var(--radius-md); background: var(--bg-surface); }
  .steps p { margin: 8px 0 0; font-size: 14px; line-height: 20px; color: var(--text-secondary); }
  .steps__num { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--bg-accent); font: 500 14px/20px var(--mono); }
  .hook { width: 360px; flex: none; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 28px; border-radius: var(--radius-md); background: var(--bg-inverse); color: var(--text-inverse); }
  .hook p { margin: 8px 0 0; font-size: 14px; line-height: 20px; color: var(--text-inverse-secondary); }

  .about { display: flex; gap: 64px; align-items: center; padding: 56px; border-radius: var(--radius-lg); background: var(--bg-inverse); color: var(--text-inverse); }
  .about__text { flex: 1; display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .about__text .lead { color: var(--text-inverse-secondary); }
  .about__eyebrow { font: 500 14px/20px var(--font); color: var(--text-accent); }
  .about__stats { width: 520px; flex: none; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .stat { display: flex; flex-direction: column; gap: 8px; padding: 24px; border-radius: var(--radius-md); background: var(--bg-inverse-subtle); }
  .stat b { font: 600 36px/42px var(--font); letter-spacing: -0.02em; color: var(--text-accent); }
  .stat b.stat__s { font-size: 24px; line-height: 30px; }
  .stat span { font-size: 14px; line-height: 20px; color: var(--text-inverse-secondary); }

  @media (max-width: 1100px) {
    .hero { flex-direction: column; align-items: stretch; gap: 32px; padding-top: 40px; }
    .hero__visual { width: auto; height: 340px; }
    .hero__circle { width: 300px; height: 300px; left: auto; right: 48px; top: 20px; }
    .hero__img { width: 320px; height: 320px; left: auto; right: 38px; top: 10px; }
    .hero__stat { right: auto; left: 24px; }
    .cats-img { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cats-text { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .features { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .feature { padding: 20px; }
    .how { flex-direction: column; }
    .hook { width: auto; padding: 24px; }
    .steps li { padding: 20px; }
    .about { flex-direction: column; align-items: stretch; gap: 32px; padding: 40px; }
    .about__stats { width: auto; }
    .stat b { font-size: 26px; line-height: 32px; }
    .stat b.stat__s { font-size: 20px; line-height: 26px; }
  }
  @media (max-width: 600px) {
    .hero { padding-top: 24px; }
    .hero__text { gap: 20px; }
    .hero__visual { display: none; }
    .search--l { height: 48px; padding: 0 4px 0 16px; border-width: 1px; border-radius: var(--radius-sm); }
    .search--l input { font-size: 16px; }
    .search--l .btn { height: 36px; padding: 0 12px; font-size: 14px; font-weight: 500; }
    .cats-text { grid-template-columns: 1fr; }
    .features { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
    .steps li { flex-direction: row; gap: 12px; padding: 16px; }
    .steps li h3 { font-size: 18px; line-height: 24px; }
    .steps p { margin: 4px 0 0; }
    .steps__num { flex: none; }
    .about { padding: 24px; }
    .about__stats { gap: 12px; }
    .stat { padding: 16px; }
    .stat b.stat__s { font-size: 18px; line-height: 24px; }
  }
</style>
