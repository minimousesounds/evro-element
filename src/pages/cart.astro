---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Корзина" noindex>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Корзина' }]} />
    <div class="page-title"><h1>Корзина</h1><span class="page-title__sub" id="cart-sub"></span></div>
    <div class="cart">
      <div class="stack" style="gap: 12px;">
        <ul class="items" id="cart-items"></ul>
        <div class="card stack" id="cart-empty" hidden>
          <p class="lead">В корзине пока пусто.</p>
          <div><a class="btn btn--l" href="/catalog/">Перейти в каталог</a></div>
        </div>
        <div class="items__actions" id="cart-actions">
          <a class="text-link small" href="/catalog/"><Icon name="chevron-left" size={18} />Продолжить выбор</a>
          <button class="text-link small muted clear" id="cart-clear" type="button"><Icon name="trash" size={18} />Очистить</button>
        </div>
      </div>
      <aside class="card stack" id="cart-side">
        <div class="sum">
          <div><span class="muted small">Позиций</span><b class="small" id="sum-lines"></b></div>
          <div><span class="muted small">Товаров</span><b class="small" id="sum-qty"></b></div>
          <div class="total"><span>Итого</span><b id="cart-total"></b></div>
        </div>
        <p class="notice"><Icon name="info" size={18} />Доставку транспортной компанией оплачиваете при получении по её тарифу.</p>
        <a class="btn btn--l btn--block" href="/checkout/">Перейти к оформлению<Icon name="arrow-right" size={20} /></a>
      </aside>
    </div>
  </div>
  <template id="cart-row">
    <li class="item">
      <a class="item__img" tabindex="-1" aria-hidden="true"><img alt="" width="88" height="88" /></a>
      <div class="item__info"><span class="item__meta"><span class="mono" data-f="sku"></span></span><a class="item__title" data-f="title"></a><span class="tertiary small" data-f="unit"></span></div>
      <span class="stepper item__qty">
        <button type="button" data-step="-1" aria-label="Меньше"><Icon name="minus" size={20} /></button>
        <input type="number" inputmode="numeric" min="1" max="9999" aria-label="Количество" />
        <button type="button" data-step="1" aria-label="Больше"><Icon name="plus" size={20} /></button>
      </span>
      <b class="item__sum" data-f="sum"></b>
      <button class="icon-btn icon-btn--soft item__remove" type="button" data-remove><Icon name="trash" size={20} /></button>
    </li>
  </template>
</Base>

<script>
  import { readCart, writeCart, cartTotal, cartCount, money } from '../scripts/cart';

  const list = document.getElementById('cart-items')!;
  const tpl = document.getElementById('cart-row') as HTMLTemplateElement;

  function render() {
    const items = readCart();
    const empty = items.length === 0;
    document.getElementById('cart-empty')!.hidden = !empty;
    document.getElementById('cart-side')!.hidden = empty;
    document.getElementById('cart-actions')!.hidden = empty;
    document.getElementById('cart-sub')!.textContent = empty ? '' : `позиций: ${items.length}, штук: ${cartCount(items)}`;
    document.getElementById('sum-lines')!.textContent = String(items.length);
    document.getElementById('sum-qty')!.textContent = `${cartCount(items)} шт.`;
    document.getElementById('cart-total')!.textContent = money(cartTotal(items));
    list.replaceChildren(
      ...items.map((i) => {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        li.dataset.id = i.id;
        const img = li.querySelector('img')!;
        if (i.image) img.src = i.image;
        else img.remove();
        li.querySelector<HTMLAnchorElement>('.item__img')!.href = i.url;
        const title = li.querySelector<HTMLAnchorElement>('[data-f="title"]')!;
        title.textContent = i.title;
        title.href = i.url;
        li.querySelector('[data-f="sku"]')!.textContent = i.sku;
        li.querySelector('[data-f="unit"]')!.textContent = `${money(i.price)} за шт.`;
        li.querySelector('[data-f="sum"]')!.textContent = money(i.price * i.qty);
        const qty = li.querySelector('input')!;
        qty.value = String(i.qty);
        qty.min = String(i.min ?? 1);
        li.querySelector('[data-remove]')!.setAttribute('aria-label', `Удалить ${i.title} ${i.sku}`);
        return li;
      }),
    );
  }

  list.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const id = input.closest<HTMLElement>('.item')?.dataset.id;
    writeCart(readCart().map((i) => (i.id === id ? { ...i, qty: Math.min(9999, Math.max(i.min ?? 1, Number(input.value) || 1)) } : i)));
    render();
  });
  list.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-remove]')) return;
    const id = (e.target as HTMLElement).closest<HTMLElement>('.item')?.dataset.id;
    writeCart(readCart().filter((i) => i.id !== id));
    render();
  });
  document.getElementById('cart-clear')!.addEventListener('click', () => {
    writeCart([]);
    render();
  });
  render();
</script>

<style is:global>
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .item { display: grid; grid-template-columns: 88px minmax(0, 1fr) auto 120px auto; gap: 24px; align-items: center; padding: 20px; background: var(--bg-surface); border-radius: var(--radius-md); }
  .item__img { display: grid; place-items: center; width: 88px; height: 88px; border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px var(--border-default); background: #fff; overflow: hidden; }
  .item__img img { width: 80px; height: 80px; object-fit: contain; }
  .item__info { display: grid; gap: 6px; }
  .item__meta { font-size: 12px; line-height: 16px; }
  .item__title { font: 600 18px/24px var(--font); letter-spacing: -0.01em; text-decoration: none; }
  .item__sum { font: 600 20px/24px var(--font); text-align: right; white-space: nowrap; }
  .item__remove { background: none; }
  .items__actions { display: flex; justify-content: space-between; padding: 8px 4px; }
  .clear { border: 0; background: none; padding: 0; cursor: pointer; }
  .sum { display: grid; gap: 10px; }
  .sum > div:not(.total) { display: flex; justify-content: space-between; }
  .sum .total { padding-top: 8px; }
  @media (max-width: 600px) {
    .item { grid-template-columns: 72px minmax(0, 1fr) auto; gap: 8px 12px; padding: 16px 12px; align-items: start; }
    .item__img { width: 72px; height: 72px; grid-row: span 2; }
    .item__img img { width: 64px; height: 64px; }
    .item__title { font: 500 14px/20px var(--font); }
    .item__remove { grid-column: 3; grid-row: 1; width: 24px; height: 24px; }
    .item__qty { grid-column: 2; grid-row: 2; }
    .item__qty.stepper { height: 36px; }
    .item__qty button { width: 32px; height: 28px; }
    .item__qty input { width: 28px; font-size: 14px; }
    .item__sum { grid-column: 3; grid-row: 2; align-self: center; font-size: 16px; }
  }
</style>
