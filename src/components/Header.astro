---
import site from '../data/site.json';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getCategories, getProducts, categoryUrl } from '../lib/catalog';
interface Props { phoneHref: string }
const { phoneHref } = Astro.props;
const categories = await getCategories();
const products = await getProducts();
const countBy = (id: string) => products.filter((p) => p.data.category.id === id).length;
const half = Math.ceil(categories.length / 2);
const path = Astro.url.pathname;
const q = Astro.url.searchParams?.get?.('q') ?? '';
---
<header class="hdr">
  <div class="hdr__top">
    <div class="container hdr__top-in">
      <span class="hdr__top-item"><Icon name="pin" size={16} />{site.city}, {site.addressShort}</span>
      <span class="hdr__top-item"><Icon name="clock" size={16} />{site.hours}</span>
      <nav class="hdr__top-nav" aria-label="Информация">
        <a href="/tech/">Техинформация</a>
        <a href="/about/">О компании</a>
        <a href="/contacts/">Контакты</a>
      </nav>
    </div>
  </div>

  <div class="container hdr__main">
    <button class="icon-btn hdr__burger" type="button" data-drawer-open aria-label="Меню"><Icon name="menu" size={22} /></button>
    <span class="hdr__logo-full"><Logo /></span>
    <span class="hdr__logo-compact"><Logo compact /></span>
    <button class="btn btn--dark hdr__catalog" type="button" data-mega-toggle aria-expanded="false" aria-controls="mega">
      <Icon name="grid" size={20} />Каталог
    </button>
    <span class="hdr__break" aria-hidden="true"></span>
    <form class="search hdr__search" action="/search/" method="get" role="search">
      <Icon name="search" size={22} class="search__icon" />
      <input type="search" name="q" value={q} placeholder="Поиск по артикулу или названию" aria-label="Поиск по каталогу" />
      <button class="btn btn--s" type="submit">Найти</button>
    </form>
    <div class="hdr__phone">
      <a href={phoneHref}>{site.phone}</a>
      <button class="link" type="button" data-callback>Заказать звонок</button>
    </div>
    <a class="icon-btn hdr__phone-btn" href={phoneHref} aria-label={`Позвонить: ${site.phone}`}><Icon name="phone" size={20} /></a>
    <a class="hdr__cart" href="/cart/" aria-current={path === '/cart/' ? 'page' : undefined}>
      <Icon name="cart" size={20} /><span class="hdr__cart-label">Корзина</span>
      <span class="counter" data-cart-count hidden>0</span>
    </a>
  </div>

  <div class="mega" id="mega" hidden>
    <div class="container mega__in">
      <div class="mega__cols">
        {[categories.slice(0, half), categories.slice(half)].map((col) => (
          <ul>
            {col.map((c) => (
              <li><a class="menu-item" href={categoryUrl(c)} aria-current={path.startsWith(categoryUrl(c)) ? 'page' : undefined}>
                <span>{c.data.title}</span><span class="menu-item__count">{countBy(c.id)}</span><Icon name="chevron-right" size={18} />
              </a></li>
            ))}
          </ul>
        ))}
      </div>
      <div class="promo">
        <div>
          <p class="promo__title">Не знаете артикул?</p>
          <p class="promo__text">Подберём фильтр по марке и модели техники или по номеру другого производителя.</p>
        </div>
        <button class="btn" type="button" data-callback>Оставить заявку</button>
      </div>
    </div>
  </div>
</header>

<dialog class="drawer" id="drawer" aria-label="Меню">
  <div class="drawer__head">
    <Logo compact />
    <button class="icon-btn icon-btn--soft" type="button" data-drawer-close aria-label="Закрыть меню"><Icon name="close" size={20} /></button>
  </div>
  <div class="drawer__body">
    <a class="btn btn--l btn--dark btn--block" href="/catalog/"><Icon name="grid" size={20} />Каталог</a>
    <ul class="drawer__cats">
      {categories.map((c) => (
        <li><a href={categoryUrl(c)}><span>{c.data.title}</span><span class="tertiary">{countBy(c.id)}</span><Icon name="chevron-right" size={18} /></a></li>
      ))}
    </ul>
    <nav class="drawer__nav" aria-label="Разделы">
      <a href="/about/">О компании</a>
      <a href="/tech/">Техническая информация</a>
      <a href="/contacts/">Контакты</a>
    </nav>
  </div>
  <div class="drawer__contacts">
    <a class="drawer__phone" href={phoneHref}>{site.phone}</a>
    <span class="muted">{site.hours}, {site.addressShort}</span>
    <button class="btn btn--block" type="button" data-callback>Заказать звонок</button>
  </div>
</dialog>

<script>
  const mega = document.getElementById('mega')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-mega-toggle]')!;
  const setMega = (open: boolean) => {
    mega.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('mega-open', open);
  };
  toggle.addEventListener('click', (e) => {
    e.stopPropagation();
    // на планшете вместо выпадающего меню ведём на страницу каталога
    if (matchMedia('(max-width: 1100px)').matches) return void (location.href = `${import.meta.env.BASE_URL}catalog/`);
    setMega(mega.hidden);
  });
  document.addEventListener('click', (e) => {
    if (!mega.hidden && !mega.contains(e.target as Node)) setMega(false);
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setMega(false));

  const drawer = document.getElementById('drawer') as HTMLDialogElement;
  document.querySelectorAll('[data-drawer-open]').forEach((b) => b.addEventListener('click', () => drawer.showModal()));
  document.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', () => drawer.close()));
  drawer.addEventListener('click', (e) => e.target === drawer && drawer.close());
  // кнопки «Заказать звонок» внутри меню сначала закрывают его
  drawer.querySelectorAll('[data-callback]').forEach((b) => b.addEventListener('click', () => drawer.close()));
  mega.querySelectorAll('[data-callback]').forEach((b) => b.addEventListener('click', () => setMega(false)));
</script>

<style>
  .hdr { position: relative; z-index: 30; background: var(--bg-surface); border-bottom: 1px solid var(--border-default); }
  .hdr__top { background: var(--bg-inverse); color: var(--text-inverse-secondary); font-size: 14px; line-height: 20px; }
  .hdr__top-in { display: flex; gap: 32px; align-items: center; min-height: 40px; }
  .hdr__top-item { display: inline-flex; gap: 8px; align-items: center; }
  .hdr__top-item .icon { color: var(--text-inverse); }
  .hdr__top-nav { margin-left: auto; display: flex; gap: 32px; }
  .hdr__top-nav a { color: var(--text-inverse); text-decoration: none; }
  .hdr__top-nav a:hover { color: var(--bg-accent); }

  .hdr__main { display: flex; gap: 24px; align-items: center; min-height: 84px; }
  .hdr__burger, .hdr__phone-btn, .hdr__logo-compact, .hdr__break { display: none; }
  .hdr__search { flex: 1; min-width: 0; }
  .hdr__phone { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; white-space: nowrap; }
  .hdr__phone a { font: 600 16px/24px var(--font); text-decoration: none; }
  .hdr__phone .link { font-size: 14px; line-height: 20px; }
  .hdr__cart { position: relative; display: inline-flex; gap: 10px; align-items: center; height: 44px; padding: 0 16px; border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--border-default); text-decoration: none; font: 600 16px/20px var(--font); white-space: nowrap; }
  .hdr__cart:hover, .hdr__cart[aria-current] { box-shadow: inset 0 0 0 1px var(--border-strong); }

  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--bg-surface); border-top: 1px solid var(--border-default);
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.12); }
  .mega__in { display: flex; gap: 48px; padding-top: 32px; padding-bottom: 40px; }
  .mega__cols { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .mega ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; align-content: start; }
  .promo { width: 380px; flex: none; display: flex; flex-direction: column; justify-content: space-between; gap: 16px; padding: 28px; border-radius: var(--radius-lg); background: var(--bg-inverse); color: var(--text-inverse); align-items: flex-start; }
  .promo__title { font: 600 24px/30px var(--font); letter-spacing: -0.015em; margin-bottom: 8px; }
  .promo__text { font-size: 14px; line-height: 20px; color: var(--text-inverse-secondary); margin: 0; }

  .drawer { margin: 0 0 0 auto; width: min(400px, 100vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; padding: 0; border: 0;
    background: var(--bg-surface); color: var(--text-primary); display: none; flex-direction: column; }
  .drawer[open] { display: flex; }
  .drawer::backdrop { background: rgb(22 22 22 / 0.5); }
  .drawer__head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border-default); }
  .drawer__body { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 24px; padding: 20px 16px 24px; }
  .drawer__body > * { flex: none; }
  .drawer__cats { list-style: none; margin: 0; padding: 0; }
  .drawer__cats a { display: flex; gap: 12px; align-items: center; padding: 12px 4px; border-bottom: 1px solid var(--border-default); text-decoration: none; }
  .drawer__cats a span:first-child { flex: 1; }
  .drawer__cats .icon { color: var(--text-tertiary); }
  .drawer__nav { display: grid; gap: 14px; }
  .drawer__nav a { font: 600 18px/24px var(--font); text-decoration: none; }
  .drawer__contacts { display: grid; gap: 8px; margin: 0 16px 16px; padding: 20px; border-radius: var(--radius-lg); background: var(--bg-page); font-size: 14px; line-height: 20px; }
  .drawer__phone { font: 600 18px/24px var(--font); text-decoration: none; }
  .drawer__contacts .btn { margin-top: 8px; }

  @media (max-width: 1100px) {
    .hdr__top, .hdr__phone, .hdr__cart-label { display: none; }
    .hdr__main { flex-wrap: wrap; gap: 12px; min-height: 0; padding-top: 14px; padding-bottom: 16px; }
    .hdr__burger { display: inline-grid; order: 5; }
    .hdr__phone-btn { display: inline-grid; margin-left: auto; }
    .hdr__cart { width: 44px; padding: 0; justify-content: center; }
    .hdr__break { display: block; order: 9; flex-basis: 100%; height: 0; }
    .hdr__catalog { order: 10; }
    .hdr__search { order: 11; flex: 1 1 0; }
  }
  @media (max-width: 600px) {
    .hdr__main { gap: 6px; padding-top: 12px; padding-bottom: 12px; }
    .hdr__burger { order: 0; }
    .hdr__logo-full { display: none; }
    .hdr__logo-compact { display: inline-flex; margin-right: auto; }
    .hdr__phone-btn { margin-left: 0; }
    .hdr__catalog { display: none; }
    .hdr__search { margin-top: 6px; flex-basis: 100%; }
    .hdr__search .btn { display: none; }
    .icon-btn, .hdr__cart { width: 40px; height: 40px; }
  }
</style>
